# Real CRT Phosphor - GBA bonus (GBA Comfort Color), LIGHT: for most games. Only very strong, bright colors are toned down; the rest stays as the game drew it.
# GBA colors first, then the CRT look (15 passes). The color is done once: the GBA pass does the grade,
# Real CRT Phosphor's own grade is neutral and only finishes gamma / white balance.
# Screen look tuned by gunkun on 4K (little smear, like an LCD; MASK_PITCH 5.5 on every screen).

shaders = "15"

shader0 = "../../shaders/gba-comfort-color.slang"
filter_linear0 = "false"
scale_type0 = "source"
scale0 = "1.000000"

shader1 = "../../shaders/box.slang"
alias1 = "Box"
filter_linear1 = false
wrap_mode1 = clamp_to_edge
scale_type1 = source
scale1 = 1.0
shader2 = "../../shaders/dither.slang"
alias2 = "Dithered"
filter_linear2 = false
wrap_mode2 = clamp_to_edge
scale_type2 = source
scale2 = 1.0
shader3 = "../../shaders/soft.slang"
alias3 = "Dither"
filter_linear3 = false
wrap_mode3 = clamp_to_edge
scale_type3 = source
scale3 = 1.0
shader4 = "../../shaders/kern.slang"
alias4 = "Kern"
filter_linear4 = false
wrap_mode4 = clamp_to_edge
float_framebuffer4 = true
scale_type4 = source
scale4 = 1.0
shader5 = "../../shaders/signal.slang"
alias5 = "SignalH"
filter_linear5 = false
wrap_mode5 = clamp_to_edge
scale_type5 = source
scale5 = 1.0
shader6 = "../../shaders/vblur.slang"
alias6 = "SigRaw"
filter_linear6 = false
wrap_mode6 = clamp_to_edge
float_framebuffer6 = true
scale_type6 = source
scale6 = 1.0
shader7 = "../../shaders/ag_mem.slang"
alias7 = "AGMem"
filter_linear7 = false
wrap_mode7 = clamp_to_edge
float_framebuffer7 = true
scale_type7 = source
scale7 = 1.0
shader8 = "../../shaders/ag_out.slang"
alias8 = "Signal"
filter_linear8 = false
wrap_mode8 = clamp_to_edge
float_framebuffer8 = true
scale_type8 = source
scale8 = 1.0
shader9 = "../../shaders/glow_h.slang"
filter_linear9 = false
wrap_mode9 = clamp_to_edge
float_framebuffer9 = true
scale_type9 = source
scale9 = 1.0
shader10 = "../../shaders/glow_v.slang"
alias10 = "Glow"
filter_linear10 = true
wrap_mode10 = clamp_to_edge
float_framebuffer10 = true
scale_type10 = source
scale10 = 1.0
shader11 = "../../shaders/beam.slang"
filter_linear11 = true
wrap_mode11 = clamp_to_edge
float_framebuffer11 = true
scale_type11 = viewport
scale11 = 1.0
shader12 = "../../shaders/rgb.slang"
filter_linear12 = true
wrap_mode12 = clamp_to_edge
float_framebuffer12 = true
scale_type12 = viewport
scale12 = 1.0
shader13 = "../../shaders/post_h.slang"
filter_linear13 = true
wrap_mode13 = clamp_to_edge
float_framebuffer13 = true
scale_type13 = viewport
scale13 = 1.0
shader14 = "../../shaders/post_v.slang"
filter_linear14 = true
wrap_mode14 = clamp_to_edge
scale_type14 = viewport
scale14 = 1.0
mipmap_input13 = false
mipmap_input14 = false

# GBA Comfort Color
GBA_VIOLET = "0.000000"
GBA_YELLOW = "0.000000"
GBA_PRIM = "0.000000"
GBA_DEEP = "0.000000"
GBA_SATURATION = "1.000000"
GBA_HUE = "0.000000"
GBA_LV_BLACK = "0.000000"
GBA_LV_WHITE = "1.000000"
GBA_S_LOW = "0.000000"
GBA_S_HIGH = "0.000000"
GBA_SECOND = "0.150000"
GBA_GAMMA = "1.000000"
GBA_WP_R = "1.000000"
GBA_WP_G = "1.000000"
GBA_WP_B = "1.000000"
GBA_BRIGHTNESS = "1.000000"
GBA_KNEE = "1.000000"

# Real CRT Phosphor
LUMA_BLUR = "0.250000"
LUMA_TAIL = "0.250000"
PEAKING = "0.250000"
CHROMA_BLUR = "0.000000"
CHROMA_TAIL = "0.000000"
SATURATION = "1.000000"
HUE = "0.000000"
LV_BLACK = "0.000000"
LV_WHITE = "1.000000"
S_LOW = "0.000000"
S_HIGH = "0.000000"
VERT_BLUR = "0.250000"
BEAM_DARK = "0.230000"
BEAM_BRIGHT = "0.360000"
GLOW = "0.040000"
GLOW_R = "0.300000"
MASK_PITCH = "5.500000"
RGB_BLUR_X = "0.150000"
RGB_BLUR_Y = "0.150000"
GAMMA_IN = "1.000000"
WP_R = "1.000000"
WP_G = "1.000000"
WP_B = "1.000000"
BRIGHT = "1.120000"
